# Local development: persistent embedded PostgreSQL, no Docker required.
HOST=127.0.0.1
PORT=4180
PUBLIC_ORIGIN=http://127.0.0.1:4180
DATA_DIR=./data/postgres
# Set for a separate PostgreSQL server. Never commit credentials.
# DATABASE_URL=postgresql://user:password@localhost:5432/angasolka
# NODE_ENV=production requires DATABASE_URL. Run db:migrate before starting.
# HTTPS: choose direct TLS OR the Nginx loopback proxy described in docs/tls-russia.md.
# PUBLIC_ORIGIN=https://your-domain.example
# TLS_CERT_FILE=/etc/angasolka/tls/fullchain.pem
# TLS_KEY_FILE=/etc/angasolka/tls/privkey.pem
# TRUST_PROXY=loopback
# Default TRUST_PROXY=none. Never expose port 4180 when using the proxy.

# Telegram is opt-in. Enabling starts real delivery of queued events.
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ADMIN_USER_ID=
# TELEGRAM_STAFF_ID=
# Requires public HTTPS. Register separately with pnpm telegram:setup.
